{
  "name": "panda-tv",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:icons": "vi build --watch",
    "build": "vite build",
    "build:preview": "vite build --mode development",
    "build:test": "vite build --mode test",
    "build:icons": "vi build",
    "preview": "vite preview",
    "fix": "eslint --fix --ext .js,.ts,.vue src",
    "format": "prettier --write .",
    "type-check": "vue-tsc --noEmit",
    "bump": "bun update @varlet/* rattail --latest",
    "commit": "git-cz",
    "lint-staged": "npx lint-staged",
    "release": "bumpp --commit --push --tag",
    "prepare": "husky"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": ".cz-config.cjs"
    }
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.vue": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{scss,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^4.5.1",
    "@fingerprintjs/fingerprintjs-pro-vue-v3": "^1.5.0",
    "@varlet/axle": "^0.9.0",
    "@varlet/bounce-fixer": "^0.0.3",
    "@varlet/touch-emulator": "3.6.4",
    "@varlet/ui": "3.6.4",
    "@varlet/use": "3.6.4",
    "@vueuse/core": "^10.5.0",
    "aliyun-aliplayer": "^2.28.4",
    "alova": "^3.2.6",
    "colorthief": "^2.6.0",
    "dayjs": "^1.11.8",
    "mitt": "^3.0.1",
    "mockjs": "^1.1.0",
    "pinia": "^2.1.3",
    "pinia-plugin-persistedstate": "^4.1.3",
    "rattail": "1.0.0",
    "shiki": "^1.22.0",
    "swiper": "^11.1.15",
    "vue": "^3.4.21",
    "vue-i18n": "^9.10.1",
    "vue-router": "^4.3.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@iconify-json/mdi": "^1.1.54",
    "@types/mockjs": "^1.0.7",
    "@types/node": "^20.2.5",
    "@types/swiper": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^5.59.8",
    "@typescript-eslint/parser": "^5.59.8",
    "@unocss/preset-rem-to-px": "^0.58.2",
    "@varlet/import-resolver": "3.6.4",
    "@varlet/preset-unocss": "3.6.4",
    "@varlet/unplugin-icon-builder": "^0.6.0",
    "@vite-pwa/assets-generator": "^0.2.6",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitejs/plugin-vue-jsx": "^3.1.0",
    "bumpp": "^9.8.1",
    "commitizen": "^4.3.1",
    "cz-customizable": "^7.2.1",
    "eslint": "^8.41.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-vue": "^9.31.0",
    "husky": "^9.1.6",
    "jsdom": "^21.0.0",
    "less": "^4.1.3",
    "lint-staged": "^15.2.10",
    "postcss-px-to-viewport-8-plugin": "^1.2.5",
    "prettier": "^2.8.8",
    "rollup-plugin-visualizer": "^5.14.0",
    "typescript": "5.0.2",
    "unocss": "^0.58.2",
    "unplugin-auto-import": "^0.17.5",
    "unplugin-vue-components": "^0.26.0",
    "unplugin-vue-router": "^0.8.6",
    "vite": "^5.0.10",
    "vite-plugin-compression2": "^0.10.1",
    "vite-plugin-eruda": "^1.0.1",
    "vite-plugin-progress": "^0.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "vue-tsc": "^1.8.27",
    "workbox-cacheable-response": "^7.3.0",
    "workbox-expiration": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-strategies": "^7.3.0"
  },
  "engines": {
    "pnpm": ">=9.0"
  }
}
